---
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const t = site.ui.notFound;
---

<BaseLayout title={t.metaTitle} description={t.text} noindex>
  <section class="container-text not-found">
    <h1 class="title">{t.title}</h1>
    <p class="text">{t.text}</p>
    <div class="actions">
      <Button href="/">{t.back}</Button>
      <Button href="/trabajos" variant="text">{site.ui.featured.viewAll}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 14vw, 12rem) 0;
  }
  .title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    max-width: 14ch;
  }
  .text {
    margin-top: 1.5rem;
    max-width: 44ch;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
</style>
