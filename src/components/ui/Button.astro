---
/**
 * Rectangular button-link. Primary = solid ink, secondary = 1px outline, text = underline.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'text' | 'on-photo';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
  size?: 'md' | 'sm';
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, `btn-${size}`, className]} {...rest}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .btn-md {
    padding: 0.875rem 1.5rem;
  }
  .btn-sm {
    padding: 0.625rem 1rem;
  }
  .btn-primary {
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    border: 1px solid var(--color-ink);
  }
  .btn-primary:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  .btn-secondary:hover {
    background-color: var(--color-ink);
    color: var(--color-on-ink);
  }
  .btn-text {
    padding-inline: 0;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
    text-decoration-color: var(--color-line);
  }
  .btn-text:hover {
    text-decoration-color: var(--color-accent);
  }
  .btn-on-photo {
    color: var(--color-on-photo);
    border: 1px solid currentColor;
  }
  .btn-on-photo:hover {
    background-color: var(--color-on-photo);
    color: var(--color-ink);
  }
  .btn :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
</style>
