---
import { Icon } from 'astro-icon/components';

import { site, whatsappUrl } from '../../config/site';
import Button from './Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (href === path || (href !== '/' && path.startsWith(href)));
---

<header class="site-header" data-header>
  <div class="container-wide bar">
    <a href="/" class="brand" aria-label={`${site.brand.name}, ${site.ui.homeLabel}`}>
      <span class="brand-name">{site.brand.name}</span>
      <span class="brand-role label">{site.ui.brandSuffix}</span>
    </a>

    <nav class="nav" aria-label={site.ui.navLabel}>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="label link-draw" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <Button href={site.cta.primary.href} size="sm" class="cta-desktop">{site.cta.primary.label}</Button>
      <button type="button" class="menu-toggle" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">
        <Icon name="lucide:menu" aria-hidden="true" />
        <span class="sr-only">{site.ui.menuOpen}</span>
      </button>
    </div>
  </div>

  <dialog id="site-menu" class="menu" aria-label={site.ui.menuTitle} data-menu>
    <div class="menu-inner">
      <div class="menu-top">
        <span class="brand-name">{site.brand.name}</span>
        <button type="button" class="menu-close" data-menu-close>
          <Icon name="lucide:x" aria-hidden="true" />
          <span class="sr-only">{site.ui.menuClose}</span>
        </button>
      </div>
      <nav aria-label={site.ui.mobileNavLabel}>
        <ul class="menu-list">
          {
            site.nav.map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={item.href} data-menu-link>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-actions">
        <Button href={site.cta.primary.href} data-menu-link>{site.cta.primary.label}</Button>
        <Button href={whatsappUrl()} variant="secondary" target="_blank" rel="noopener">
          <Icon name="lucide:message-circle" aria-hidden="true" />
          {site.cta.whatsappLabel}
        </Button>
        <p class="label menu-meta">{site.contact.studio}</p>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  :global(.is-scrolled) .site-header {
    border-bottom-color: var(--color-line);
  }
  .bar {
    height: var(--spacing-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    min-height: 2.75rem;
    align-content: center;
    padding-block: 0.5rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .brand-role {
    color: var(--color-muted);
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .nav a {
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .nav a::after {
    bottom: 0.65rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .actions :global(.cta-desktop) {
    display: none;
  }
  .menu-toggle,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
  }
  .menu-toggle :global(svg),
  .menu-close :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
    stroke-width: 1.5;
  }
  @media (min-width: 64rem) {
    .nav {
      display: block;
    }
    .actions :global(.cta-desktop) {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }

  /* Full-screen mobile menu */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-bg);
    color: var(--color-ink);
  }
  .menu::backdrop {
    background-color: var(--color-bg);
  }
  .menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 var(--spacing-gutter) calc(2rem + env(safe-area-inset-bottom));
  }
  .menu-top {
    height: var(--spacing-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-list {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .menu-list a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 10vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .menu-actions {
    margin-top: auto;
    padding-top: 2.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .menu-meta {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu-list li {
      animation: rise var(--duration-base) var(--ease-out) both;
      animation-delay: calc(var(--i) * 60ms + 80ms);
    }
  }
</style>

<script>
  function initMenu() {
    const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    if (!menu || !openBtn || menu.dataset.ready) return;
    menu.dataset.ready = 'true';

    openBtn.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => menu.close()));
    menu.addEventListener('close', () => openBtn.focus());
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && menu.open && menu.close());
  }

  function initScrollState() {
    const root = document.documentElement;
    const update = () => root.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  initScrollState();
  document.addEventListener('astro:page-load', initMenu);
</script>
