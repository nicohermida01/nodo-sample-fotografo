---
/**
 * Responsive photo: WebP <picture> with JPG fallback (no AVIF: slower builds, larger files with sharp), intrinsic width/height (no CLS),
 * dominant-color ground while loading. Never crops unless `fill` is set
 * (then the parent decides the aspect ratio).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import { dominantColor } from '../../lib/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  /** Fill the parent box with object-fit: cover (cards with a fixed aspect ratio). */
  fill?: boolean;
  /** Aspect ratio for the frame when filling, e.g. "4 / 5". */
  aspect?: string;
  eager?: boolean;
  class?: string;
  reveal?: boolean;
  stagger?: 0 | 1 | 2;
  parallax?: boolean;
  transitionName?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [480, 800, 1200, 1600, 2000],
  fill = false,
  aspect,
  eager = false,
  class: className,
  reveal = true,
  stagger = 0,
  parallax = false,
  transitionName,
} = Astro.props;

const usableWidths = widths.filter((w) => w <= src.width);
if (usableWidths.length === 0 || usableWidths[usableWidths.length - 1] < src.width) usableWidths.push(src.width);

const ground = await dominantColor(src);
const style = [ground && `background-color:${ground}`, `aspect-ratio:${aspect ?? `${src.width} / ${src.height}`}`]
  .filter(Boolean)
  .join(';');

const classes = ['photo', fill && 'photo-fill', reveal && 'reveal', parallax && 'parallax', className]
  .filter(Boolean)
  .join(' ');
---

{
  transitionName ? (
    <div class={classes} style={style} data-stagger={stagger || undefined} transition:name={transitionName}>
      <Picture
        src={src}
        alt={alt}
        formats={['webp']}
        widths={usableWidths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : 'auto'}
        quality={82}
      />
    </div>
  ) : (
    <div class={classes} style={style} data-stagger={stagger || undefined}>
      <Picture
        src={src}
        alt={alt}
        formats={['webp']}
        widths={usableWidths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : 'auto'}
        quality={82}
      />
    </div>
  )
}
