---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import StickyCta from '../components/ui/StickyCta.astro';
import { site } from '../config/site';
import { socialImageUrl } from '../lib/images';

interface Props {
  /** Page title without the brand suffix. */
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Show the footer's closing inquiry band. */
  footerClosing?: boolean;
}

const {
  title,
  description,
  ogImage = site.hero.images[0].src,
  ogImageAlt = site.hero.images[0].alt,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  footerClosing = false,
} = Astro.props;

const fullTitle = `${title} | ${site.brand.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImageUrl = await socialImageUrl(ogImage);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4efe8" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.brand.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      (function () {
        var supportsScroll = window.CSS && CSS.supports('animation-timeline: view()');
        var apply = function () {
          if (!supportsScroll && 'IntersectionObserver' in window) document.documentElement.classList.add('io-reveal');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#contenido" class="skip-link">{site.ui.skipToContent}</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer closing={footerClosing} />
    <StickyCta />

    <script>
      // IntersectionObserver fallback for scroll-driven reveals.
      function initReveal() {
        if (!document.documentElement.classList.contains('io-reveal')) return;
        const targets = document.querySelectorAll('.reveal, .reveal-text');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: 0.75rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    font-size: var(--text-small);
    transform: translateY(-200%);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  main:focus {
    outline: none;
  }
</style>
